# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL ---
# Before starting the app: run mysql-setup.sql once in phpMyAdmin's SQL tab
# (inside your undernutrition_dss database) to create all the tables. No other
# tool is needed for that — just paste the file and click Go.
#
# Match the host/port/user/password to what YOUR MySQL is actually running as
# (check phpMyAdmin's top bar, e.g. "Server: 127.0.0.1:3307", for the exact
# host and port XAMPP assigned you — it isn't always localhost:3306).
DATABASE_URL=mysql://root:@localhost:3306/undernutrition_dss

# --- Auth ---
# Long random string used to sign session/auth cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- App ---
NODE_ENV=development

# --- Email (SMTP via Gmail) ---
# To send emails, create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to "App passwords" and generate one for "Mail"
#   4. Use that 16-character password as SMTP_PASS (NOT your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
ADMIN_EMAIL=lojongchristine248@gmail.com
EMAIL_FROM=Child Undernutrition DSS <your-email@gmail.com>
APP_URL=http://localhost:3000

# --- Optional (leave unset unless you use these features) ---
# VITE_APP_ID=nutrition-dss
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
